<script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>
<script>
const PLACEHOLDER = 'data:image/svg+xml;utf8,' + encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" width="100" height="70" viewBox="0 0 100 70"><rect width="100" height="70" fill="#0f172a"/><text x="50" y="40" font-size="14" fill="#00f2fe" text-anchor="middle" font-family="Arial">SPRtix</text></svg>'
);
let playerInstance = null;
let cat = 'All', term = '';
const dead = new Set();

function esc(str){return String(str==null?'':str).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function safeImg(url){return esc(url||PLACEHOLDER);}
let toastTimer;
function showToast(msg){
  const t=document.getElementById('toastPopup'); t.textContent=msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),3500);
}

/* ---------------- PLAYER (index.html wala same player) ---------------- */
function initPlayer(){
  playerInstance = videojs('videoPlayer', {
    fill: true,
    controls: true,
    autoplay: false,
    preload: 'auto',
    playsinline: true,
    html5: {
      vhs: { overrideNative: true, enableLowInitialPlaylist: true, smoothQualityChange: true, withCredentials: false },
      nativeAudioTracks: false,
      nativeVideoTracks: false
    }
  });
  playerInstance.on('error', () => {
    const err = playerInstance.error();
    if (err) {
      console.error('Player error:', err);
      if (window.currentIdx != null) markDead(window.currentIdx);
      showToast('Stream error: link may be offline, blocked (CORS) or http on https');
    }
  });
}

function detectType(url){
  const u = url.split('?')[0].split('#')[0].toLowerCase();
  if (u.endsWith('.mp4') || u.endsWith('.m4v')) return 'video/mp4';
  if (u.endsWith('.webm')) return 'video/webm';
  if (u.endsWith('.ogv') || u.endsWith('.ogg')) return 'video/ogg';
  if (u.endsWith('.mkv')) return 'video/webm';
  if (u.endsWith('.mpd')) return 'application/dash+xml';
  // .m3u8, and also links with no extension (most live TV / IPTV links) are treated as HLS
  return 'application/x-mpegURL';
}

function playStream(url, title){
  url = (url || '').trim();
  if (!url) { showToast('Stream URL not available!'); return; }
  document.getElementById('playerTitle').innerText = title || 'Live Stream';
  document.getElementById('playerModal').classList.add('active');
  playerInstance.pause();
  playerInstance.reset();
  playerInstance.src({ src: url, type: detectType(url) });
  playerInstance.load();
  const p = playerInstance.play();
  if (p && p.catch) p.catch(() => { /* user can tap the big play button */ });
}

function closePlayer(){
  document.getElementById('playerModal').classList.remove('active');
  playerInstance.pause();
  playerInstance.reset(); // fully stops the stream so it stops downloading in background
  window.currentIdx = null;
}

function markDead(i){
  dead.add(i);
  const c = document.querySelector('.channel-card[data-i="'+i+'"]'); if (c) c.classList.add('dead');
}

/* ---- AUTO background colour: image ke kinaron ka sab se zyada aane wala rang (index.html se) ---- */
const bgColorCache = {};
function applyAutoBg(wrap, url){
  if (!url) return;
  const paint = (rgb) => {
    wrap.style.backgroundColor = rgb;
    const blurImg = wrap.querySelector('.thumb-bg');
    if (blurImg) blurImg.style.display = 'none';
  };
  if (bgColorCache[url]) { paint(bgColorCache[url]); return; }
  const probe = new Image();
  probe.crossOrigin = 'anonymous';
  probe.onload = () => {
    try {
      const S = 40;
      const cv = document.createElement('canvas'); cv.width = S; cv.height = S;
      const ctx = cv.getContext('2d', { willReadFrequently: true });
      ctx.drawImage(probe, 0, 0, S, S);
      const d = ctx.getImageData(0, 0, S, S).data;
      const buckets = {}; let best = null, bestCount = 0, opaque = 0;
      const take = (x, y) => {
        const i = (y * S + x) * 4;
        if (d[i + 3] < 40) return;
        opaque++;
        const key = (d[i] >> 5) + ',' + (d[i + 1] >> 5) + ',' + (d[i + 2] >> 5);
        const b = buckets[key] || (buckets[key] = { n: 0, r: 0, g: 0, b: 0 });
        b.n++; b.r += d[i]; b.g += d[i + 1]; b.b += d[i + 2];
        if (b.n > bestCount) { bestCount = b.n; best = b; }
      };
      for (let k = 0; k < S; k++) { take(k, 0); take(k, S - 1); take(0, k); take(S - 1, k); }
      if (!best || opaque < S) return;
      const rgb = `rgb(${Math.round(best.r / best.n)},${Math.round(best.g / best.n)},${Math.round(best.b / best.n)})`;
      bgColorCache[url] = rgb; paint(rgb);
    } catch (e) { /* CORS block: blur wala background hi chalega */ }
  };
  probe.src = url;
}

/* ---------------- GRID ---------------- */
function initials(n){return (n.replace(/[^A-Za-z0-9 ]/g,'').trim().split(/\s+/).slice(0,2).map(w=>w[0]).join('')||'?').toUpperCase();}

function buildCard(i){
  const c = CHANNELS[i];
  const card = document.createElement('div');
  card.className = 'channel-card' + (dead.has(i) ? ' dead' : '');
  card.dataset.i = i;
  card.setAttribute('role','button'); card.tabIndex = 0;
  card.innerHTML = `
    <div class="thumb-wrap"></div>
    <div class="channel-logo-text">${esc(c.n)}</div>
    <div class="channel-footer">
      <span class="live-badge">LIVE</span>
      <span class="view-count">${esc(c.q || 'Online')}</span>
    </div>`;
  const wrap = card.querySelector('.thumb-wrap');
  const fallback = () => { wrap.innerHTML = '<div class="ini">'+esc(initials(c.n))+'</div>'; wrap.style.backgroundColor='#111827'; };
  if (!c.l) fallback();
  else {
    wrap.innerHTML = `<img src="${safeImg(c.l)}" class="thumb-bg" alt=""><img src="${safeImg(c.l)}" class="card-thumb" loading="lazy" alt="">`;
    wrap.querySelectorAll('img').forEach(im => { im.onerror = fallback; });
    applyAutoBg(wrap, c.l);
  }
  return card;
}

function render(){
  const t = term.trim().toLowerCase();
  const grid = document.getElementById('grid');
  grid.innerHTML = '';
  const frag = document.createDocumentFragment();
  let n = 0;
  CHANNELS.forEach((c,i) => {
    if (cat !== 'All' && !c.g.includes(cat)) return;
    if (t && !c.n.toLowerCase().includes(t)) return;
    frag.appendChild(buildCard(i)); n++;
  });
  grid.appendChild(frag);
  if (!CHANNELS.length) { showLoader(); document.getElementById('count').textContent = ''; return; }
  if (!n) grid.innerHTML = '<div class="empty-msg">No channels found.</div>';
  document.getElementById('count').textContent = n + ' of ' + CHANNELS.length + ' channels';
}

function buildChips(){
  const counts = {};
  CHANNELS.forEach(c => c.g.forEach(g => counts[g] = (counts[g]||0)+1));
  const names = ['All', ...Object.keys(counts).sort((a,b)=>((b==='Pakistan')-(a==='Pakistan'))||(counts[b]-counts[a]))];
  const box = document.getElementById('chips');
  box.innerHTML = '';
  names.forEach(n => {
    const b = document.createElement('button');
    b.className = 'chip'; b.textContent = n === 'All' ? 'All' : n + ' ' + counts[n];
    b.setAttribute('aria-pressed', n === cat);
    b.onclick = () => { cat = n; [...box.children].forEach((x,k)=>x.setAttribute('aria-pressed', names[k]===cat)); render(); };
    box.appendChild(b);
  });
}


/* ---------------- PLAYLIST LOADER ---------------- */
const STORE_KEY = 'sprtix_movie_playlist';

function parseM3U(text){
  const lines = String(text).split(/\r?\n/), out = [];
  for (let i = 0; i < lines.length; i++) {
    const l = lines[i].trim();
    if (!l.startsWith('#EXTINF')) continue;
    const m = l.match(/,([^,]*)$/);                       // naam hamesha aakhri comma ke baad hota hai
    let name = (m ? m[1] : '').trim();
    const logo = (l.match(/tvg-logo="([^"]*)"/) || [])[1] || '';
    const grp  = (l.match(/group-title="([^"]*)"/) || [])[1] || '';
    let j = i + 1;
    while (j < lines.length && lines[j].trim() && lines[j].trim().startsWith('#') && !lines[j].trim().startsWith('#EXTINF')) j++;
    while (j < lines.length && !lines[j].trim()) j++;
    const url = (lines[j] || '').trim();
    if (!url || url.startsWith('#')) continue;            // URL missing: is entry ko chor do
    let tag = '';
    name = name.replace(/\s*\[([^\]]+)\]\s*/g, (_, t) => { tag = t; return ' '; }).trim();
    const q = name.match(/\s*\(([^)]*\d+[pi])\)\s*$/);
    let quality = '';
    if (q) { quality = q[1]; name = name.slice(0, q.index).trim(); }
    if (!name) continue;
    const g = grp.split(';').map(x => x.trim()).filter(Boolean);
    out.push({ n: name, l: logo, g: g.length ? g : ['Other'], q: /geo/i.test(tag) ? 'Geo-blocked' : (quality || ''), u: url });
    i = j;
  }
  return out;
}

function setPlaylist(text, save){
  const list = parseM3U(text);
  if (!list.length) { showToast('Is file mein koi channel nahi mila (#EXTINF lines chahiye)'); return false; }
  CHANNELS = list; cat = 'All'; term = ''; dead.clear();
  document.getElementById('searchInput').value = '';
  buildChips(); render();
  if (save) { try { localStorage.setItem(STORE_KEY, text); } catch (e) {} }
  showToast(list.length + ' channels loaded');
  return true;
}

function showLoader(){
  const grid = document.getElementById('grid');
  grid.innerHTML = `
    <div class="loader">
      <h3>Movie playlist load karein</h3>
      <p>Apni news playlist (.m3u / .txt) select karein ya neeche paste karein. Ek baar load karne ke baad ye browser mein save rehti hai.</p>
      <button class="go" type="button" id="pickBtn">Playlist file select karein</button>
      <textarea id="pasteBox" placeholder="#EXTM3U ... yahan paste karein"></textarea>
      <button class="go alt" type="button" id="pasteBtn">Paste se load karein</button>
    </div>`;
  document.getElementById('pickBtn').onclick = () => document.getElementById('fileInput').click();
  document.getElementById('pasteBtn').onclick = () => setPlaylist(document.getElementById('pasteBox').value, true);
}

function openChannel(card){
  const i = +card.dataset.i, c = CHANNELS[i];
  dead.delete(i); card.classList.remove('dead');
  window.currentIdx = i;
  playStream(c.u, c.n);
}

window.addEventListener('DOMContentLoaded', () => {
  initPlayer();
  if (!CHANNELS.length) {
    try { const saved = localStorage.getItem(STORE_KEY); if (saved) CHANNELS = parseM3U(saved); } catch (e) {}
  }
  buildChips();
  render();

  const grid = document.getElementById('grid');
  grid.addEventListener('click', e => { const c = e.target.closest('.channel-card'); if (c) openChannel(c); });
  grid.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { const c = e.target.closest('.channel-card'); if (c) { e.preventDefault(); openChannel(c); } } });
  let st; document.getElementById('searchInput').addEventListener('input', e => { term = e.target.value; clearTimeout(st); st = setTimeout(render, 120); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePlayer(); });
});
